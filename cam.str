#!/bin/bash
set -euo pipefail

# Executar de dentro da pasta merge/
# Estrutura esperada:
#   raiz/
#     merge/
#     win01/02/
#     win02/02/
#     ...
#     win14/02/

START_WIN=1
END_WIN=14
ROOT=".."

for i in $(seq -w "$START_WIN" "$END_WIN"); do
    srcdir="${ROOT}/win${i}/02"

    # grad
    if [ -f "${srcdir}/win${i}.02.grad" ]; then
        ln -sf "${srcdir}/win${i}.02.grad" "win${i}.02.grad"
    else
        echo "Aviso: não encontrei ${srcdir}/win${i}.02.grad"
    fi

    # count
    if [ -f "${srcdir}/win${i}.02.count" ]; then
        ln -sf "${srcdir}/win${i}.02.count" "win${i}.02.count"
    else
        echo "Aviso: não encontrei ${srcdir}/win${i}.02.count"
    fi
done

echo "Links simbólicos criados/atualizados na pasta merge."
